{
  "name": "silverken-agent-world",
  "version": "0.1.0-alpha2",
  "private": true,
  "type": "module",
  "description": "SilverKen's 3D read-only visual control center for AI coding agents, derived from Bot Crossing.",
  "license": "MIT",
  "author": "Jarren Rocks",
  "contributors": [
    "Silverken92"
  ],
  "homepage": "https://github.com/Silverken92/silverken-agent-world",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Silverken92/silverken-agent-world.git"
  },
  "bugs": {
    "url": "https://github.com/Silverken92/silverken-agent-world/issues"
  },
  "keywords": [
